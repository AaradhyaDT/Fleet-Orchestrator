# ==============================================================================
# COPILOT MULTI-ACCOUNT FLEET CONFIGURATION (.env.fleet)
# ==============================================================================
# INSTRUCTIONS:
# 1. Generate Fine-Grained Personal Access Tokens (v2) on GitHub:
#    Settings -> Developer Settings -> Personal Access Tokens -> Fine-grained tokens
# 2. Scope & Permissions:
#    - Repository access: "All repositories" (or select repositories workers should touch)
#    - Account permissions: "Copilot Requests" -> Read & Write
# 3. Paste the generated tokens below for each account (unquoted or quoted).
# 4. Each account provides 200 monthly AI credits ($N x 200 credit pool).
# ==============================================================================

# --- Account 1 (Primary / Lead) ---
COPILOT_ACCOUNT_1_NAME=AaradhyaDT
COPILOT_ACCOUNT_1_TOKEN=
COPILOT_ACCOUNT_1_MONTHLY_CREDITS=200

# --- Account 2 (Worker / claudeuser0) ---
COPILOT_ACCOUNT_2_NAME=Aaradhya-claudeuser0
COPILOT_ACCOUNT_2_TOKEN=
COPILOT_ACCOUNT_2_MONTHLY_CREDITS=200

# --- Account 3 (Worker / claudeuser1) ---
COPILOT_ACCOUNT_3_NAME=Aaradhya-claudeuser1
COPILOT_ACCOUNT_3_TOKEN=
COPILOT_ACCOUNT_3_MONTHLY_CREDITS=200

# --- Account 4 (Worker / claudeuser2) ---
COPILOT_ACCOUNT_4_NAME=Aaradhya-claudeuser2
COPILOT_ACCOUNT_4_TOKEN=
COPILOT_ACCOUNT_4_MONTHLY_CREDITS=200

# --- Account 5 (Worker / claudeuser3) ---
COPILOT_ACCOUNT_5_NAME=Aaradhya-claudeuser3
COPILOT_ACCOUNT_5_TOKEN=
COPILOT_ACCOUNT_5_MONTHLY_CREDITS=200

# ==============================================================================
# FLEET SAFETY & BUDGET LIMITS
# ==============================================================================
COPILOT_MAX_CREDITS_PER_TASK=30
COPILOT_WORKER_STATE_ROOT=~/.copilot-workers
