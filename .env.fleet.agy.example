# ==============================================================================
# ANTIGRAVITY (AGY) CLI FLEET CONFIGURATION (.env.fleet.agy)
# ==============================================================================
# INSTRUCTIONS & ARCHITECTURE:
# The AGY fleet pools instances of the Google Antigravity CLI (agy.exe) to execute
# high-agency autonomous coding, refactoring, research, and review tasks in parallel.
#
# CRITICAL QUIRKS & PITFALLS:
# - [QUIRK 1 - STDIN APPROVAL BLOCKING]:
#   agy.exe runs interactively by default. In headless background/fleet mode, you MUST
#   supply `--dangerously-skip-permissions`, otherwise workers hang waiting for human
#   approval when modifying files or running shell commands.
#
# - [QUIRK 2 - WORKER SESSION & AUTH ISOLATION]:
#   agy stores auth tokens, history, and settings in `%USERPROFILE%\.gemini\antigravity-cli\`.
#   To run multiple workers concurrently without database locks or token collisions:
#   * Each worker MUST be given an isolated AGY_WORKER_N_HOME directory.
#   * Each worker profile directory maintains its own authentication state.
#
# - [QUIRK 3 - TRUSTED WORKSPACES]:
#   agy.exe checks trusted directories. Ensure target workspaces
#   (e.g., F:\Aaradhya-Dev-Tamrakar\Fleet-Orchestrator) are present in the worker's
#   trustedWorkspaces list, or pass `--add-dir` explicitly.
#
# - [QUIRK 4 - OUTPUT PARSING]:
#   For automated orchestration, workers run in print mode:
#   `agy -p "<prompt>" --dangerously-skip-permissions --output-format json`
#
# - [QUIRK 5 - PRINT TIMEOUT]:
#   Always enforce `--print-timeout 300s` (or via AGY_TASK_TIMEOUT_SECONDS) to prevent
#   unbounded loops if an agent encounters an unresolvable issue.
# ==============================================================================

# Fleet runtime settings
AGY_CLI_BINARY=C:\Users\Aaradhya\AppData\Local\agy\bin\agy.exe
AGY_DEFAULT_MODEL=gemini-3.8-flash
AGY_DEFAULT_EFFORT=high
AGY_DANGEROUSLY_SKIP_PERMISSIONS=true
AGY_TASK_TIMEOUT_SECONDS=300
AGY_WORKER_STATE_ROOT=~/.agy-workers

# ==============================================================================
# AGY WORKER POOL ROSTER (CONFIGURE YOUR AGENTS / PROFILES)
# ==============================================================================

# --- Worker 1: Lead Orchestrator ---
AGY_WORKER_1_ID=agy-w1
AGY_WORKER_1_NAME=Primary-Lead
AGY_WORKER_1_ACCOUNT=AaradhyaDT
AGY_WORKER_1_HOME=~/.agy-workers/worker1
AGY_WORKER_1_MODEL=gemini-3.8-flash
AGY_WORKER_1_EFFORT=high
AGY_WORKER_1_ROLE=orchestrator

# --- Worker 2: Systems & Code Craftsman ---
AGY_WORKER_2_ID=agy-w2
AGY_WORKER_2_NAME=Code-Craftsman
AGY_WORKER_2_ACCOUNT=Aaradhya-Dev
AGY_WORKER_2_HOME=~/.agy-workers/worker2
AGY_WORKER_2_MODEL=gemini-3.8-flash
AGY_WORKER_2_EFFORT=high
AGY_WORKER_2_ROLE=writer

